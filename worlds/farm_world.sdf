            <diffuse>0.5 0.2 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Grain Silo -->
    <model name="silo">
      <static>true</static>
      <pose>20 -12 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>1.5</radius>
              <length>7</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>1.5</radius>
              <length>7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Silo Top -->
    <model name="silo_top">
      <static>true</static>
      <pose>20 -12 7.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>1.6</radius>
              <length>1</length>
