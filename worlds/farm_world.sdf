    <!-- ============== WATER IRRIGATION CHANNELS ============== -->
    
    <!-- Left Main Irrigation Channel -->
    <model name="water_left">
      <static>true</static>
      <pose>-12.5 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 32 0.15</size>
