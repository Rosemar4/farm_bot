    <!-- ============== FARM BUILDINGS ============== -->
    
    <!-- Main Barn -->
    <model name="main_barn">
      <static>true</static>
      <pose>15 -12 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6 5 5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6 5 5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.25 0.15 1</ambient>
            <diffuse>0.75 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Barn Roof -->
    <model name="barn_roof">
      <static>true</static>
      <pose>15 -12 5.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>6.5 5.5 0.3</size>
