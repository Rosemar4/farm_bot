          <material>
            <ambient>0.5 0.1 0.1 1</ambient>
            <diffuse>0.6 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Greenhouse -->
    <model name="greenhouse">
      <static>true</static>
      <pose>-15 -10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>5 8 3</size>
